# Copy these into Hostinger Docker Manager → Environment variables (or .env next to docker-compose.yml)
DOMAIN=rigconfigurator.com
POSTGRES_USER=rig
POSTGRES_PASSWORD=change-this-long-random
POSTGRES_DB=rigconfigurator
AMAZON_TAG=rigconfigurator-20
REVALIDATE_SECRET=change-this-random
# Amazon Creators API (Associates Central > Tools > Creators API). Leave empty to show price bands only.
# Real values go ONLY in the .env on the server, never in git.
CREATORS_CREDENTIAL_ID=
CREATORS_CREDENTIAL_SECRET=
CREATORS_VERSION=
# Keepa (optional, deals board)
KEEPA_KEY=
# IndexNow (Bing, Yandex, DuckDuckGo get told about new/updated pages at once). 32 hex chars, e.g. `openssl rand -hex 16`.
# The site serves it at /indexnow-key.txt. Leave empty to disable.
INDEXNOW_KEY=
